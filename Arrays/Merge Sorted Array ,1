/*
from vector nums1 we have to take m starting elemnt simillarly from nums2 take n elements
however that may include zero*/

class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
        
        vector<int> op;

        for (int i = 0; i < m; i++) {
            op.push_back(nums1[i]);
        }

        for (int i = 0; i < n; i++) {
            op.push_back(nums2[i]);
        }

        sort(op.begin(), op.end());

        for (int i = 0; i < m + n; i++) {
            nums1[i] = op[i];
        }
    }
};

