class Solution {
public:
    int sub(int x, int y) {
        return y - x;
    }

    int maxProfit(vector<int>& prices) {

        int ans = 0;

        for (int i = 0; i < prices.size(); i++) {

            for (int j = i + 1; j < prices.size(); j++) {

                if (prices[i] < prices[j]) {

                    int profit = sub(prices[i], prices[j]);

                    if (profit > ans) {
                        ans = profit;
                    }
                }
            }
        }

        return ans;
    }
};
